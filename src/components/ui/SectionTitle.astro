---
interface Props {
  title: string;
  subtitle?: string;
  align?: "left" | "center";
}

const { title, subtitle, align = "left" } = Astro.props;
---

<div class={`max-w-3xl ${align === "center" ? "mx-auto text-center" : ""}`}>
  <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
    {title}
  </h2>

  {subtitle && <p class="mt-4 text-lg text-(--text-muted)">{subtitle} </p>}
</div>
