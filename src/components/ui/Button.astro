---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  className?: string;

  [key: string]: any;
}

const { href, variant = "primary", className = "", ...props } = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center rounded-xl px-5 py-3 text-sm font-medium transition-all duration-200";

const variants = {
  primary: "bg-(--primary) text-white hover:bg-(--primary-hover)",

  secondary:
    "border border-(--border) bg-(--surface) hover:bg-(--surface-muted)",
};

const styles = `${baseStyles} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={styles} {...props}>
      <slot />
    </a>
  ) : (
    <button class={styles} {...props}>
      <slot />
    </button>
  )
}
