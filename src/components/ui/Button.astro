---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  className?: string;

  [key: string]: any;
}

const { href, variant = "primary", className = "", ...props } = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center rounded-2xl px-6 py-3.5 text-sm font-semibold transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--primary) focus-visible:ring-offset-2";

const variants = {
  primary:
    "bg-(--primary) text-white shadow-sm hover:-translate-y-0.5 hover:bg-(--primary-hover)",

  secondary:
    "border border-(--border) bg-(--surface) text-(--text) hover:-translate-y-0.5 hover:bg-(--surface-muted)",
};

const styles = `${baseStyles} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={styles} {...props}>
      <slot />
    </a>
  ) : (
    <button class={styles} {...props}>
      <slot />
    </button>
  )
}
